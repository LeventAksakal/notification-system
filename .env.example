# Copy to .env and adjust. Placeholders only; never commit real secrets.

# Service (internal/config/config.go)
# HTTP listen address.
APP_HTTP_ADDR=:8080
# MySQL DSN (go-sql-driver format); required, injected at runtime.
APP_DATABASE_DSN=app:change-me@tcp(localhost:3306)/app
# Valkey host:port.
APP_VALKEY_ADDR=localhost:6379
# OTLP/HTTP base URL, e.g. http://localhost:4318; empty disables telemetry export.
APP_OTLP_ENDPOINT=
# service.name on every span, metric and log.
APP_SERVICE_NAME=notifier
# Log level: debug, info, warn or error.
APP_LOG_LEVEL=info
# MySQL pool size [1..200].
APP_DB_MAX_OPEN_CONNS=10
# Time a client has to send request headers [1s..1m].
APP_READ_HEADER_TIMEOUT=5s
# Grace period for in-flight requests on SIGTERM [1s..2m].
APP_SHUTDOWN_TIMEOUT=10s

# Compose stack (docker-compose.yml)
# Password of the MySQL app user.
MYSQL_PASSWORD=change-me
# Password of the MySQL root user.
MYSQL_ROOT_PASSWORD=change-me-root
# Host port for the app (default 8080).
APP_PORT=8080
# Host port for Grafana (default 3000).
GRAFANA_PORT=3000
